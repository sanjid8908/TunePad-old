<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/drawerLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<RelativeLayout
		android:id="@+id/rootReadView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#F4ECD8">
		<RelativeLayout
			android:id="@+id/toolbarLayout"
			android:layout_width="match_parent"
			android:layout_height="60dp"
			android:elevation="4dp"
			android:paddingHorizontal="20dp"
			android:layout_alignParentTop="true">
			<ImageView
				android:id="@+id/btnBack"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:scaleType="center"
				android:src="@android:drawable/ic_menu_revert"
				app:tint="#3E2723"
				android:layout_centerVertical="true" />
			<TextView
				android:id="@+id/tvBookTitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#3E2723"
				android:alpha="0.8"
				android:layout_centerInParent="true" />
			<ImageView
				android:id="@+id/btnReaderSettings"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:scaleType="center"
				android:src="@android:drawable/ic_menu_manage"
				app:tint="#3E2723"
				android:layout_alignParentEnd="true"
				android:layout_centerVertical="true" />
			<ImageView
				android:id="@+id/btnTocHeader"
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:scaleType="center"
				android:src="@android:drawable/ic_menu_sort_by_size"
				android:layout_marginEnd="20dp"
				app:tint="#3E2723"
				android:layout_toStartOf="@id/btnReaderSettings"
				android:layout_centerVertical="true" />
		</RelativeLayout>
		<ScrollView
			android:id="@+id/vscroll8"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scrollbars="none"
			android:layout_below="@id/toolbarLayout">
			<LinearLayout
				android:id="@+id/linear10"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="100dp"
				android:orientation="vertical">
				<ImageView
					android:id="@+id/imgReadCover"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="50dp"
					android:layout_marginTop="20dp"
					android:layout_marginRight="50dp"
					android:src="@drawable/default_image"
					android:scaleType="fitCenter"
					android:adjustViewBounds="true"
					android:visibility="gone" />
				<LinearLayout
					android:id="@+id/linear9"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingHorizontal="28dp">
					<TextView
						android:id="@+id/tvReadTitle"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="32dp"
						android:text="গল্পের নাম"
						android:textSize="32sp"
						android:textStyle="bold"
						android:textColor="#212121"
						android:layout_gravity="center_horizontal" />
					<TextView
						android:id="@+id/tvReadAuthor"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="লেখিকার নাম"
						android:textSize="18sp"
						android:textColor="#555555"
						android:layout_gravity="center_horizontal" />
					<View
						android:id="@+id/dividerLine"
						android:layout_width="60dp"
						android:layout_height="2dp"
						android:layout_marginTop="40dp"
						android:layout_marginBottom="40dp"
						android:background="#BDBDBD"
						android:layout_gravity="center_horizontal" />
					<LinearLayout
						android:id="@+id/chapterContainer"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical" />
				</LinearLayout>
			</LinearLayout>
		</ScrollView>
		<LinearLayout
			android:id="@+id/floatingButtonsLayout"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginBottom="30dp"
			android:orientation="vertical"
			android:layout_marginEnd="20dp"
			android:visibility="gone"
			android:layout_alignParentBottom="true"
			android:layout_alignParentEnd="true">
			<ImageView
				android:id="@+id/fabToc"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:layout_marginBottom="16dp"
				android:padding="10dp"
				android:background="@drawable/circle_border_bg"
				android:src="@drawable/icon_format_list_bulleted_round"
				android:scaleType="fitCenter"
				android:layout_gravity="center_horizontal"
				android:elevation="6dp"
				app:tint="#3E2723" />
			<ImageView
				android:id="@+id/fabSettings"
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:padding="14dp"
				android:background="@drawable/circle_border_bg"
				android:src="@drawable/ic_my_settings_icon"
				android:scaleType="fitCenter"
				android:layout_gravity="center_horizontal"
				android:elevation="6dp"
				app:tint="#3E2723" />
		</LinearLayout>
	</RelativeLayout>
	<LinearLayout
		android:id="@+id/tocDrawer"
		android:layout_width="280dp"
		android:layout_height="match_parent"
		android:paddingTop="30dp"
		android:background="#EFEAE1"
		android:orientation="vertical"
		android:layout_gravity="end">
		<TextView
			android:id="@+id/textview2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="12dp"
			android:text="সূচিপত্র"
			android:textSize="22sp"
			android:textStyle="bold"
			android:textColor="#3E2723"
			android:paddingHorizontal="24dp" />
		<View
			android:id="@+id/view2"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginBottom="8dp"
			android:background="#D7CCC8"
			android:layout_marginHorizontal="24dp" />
		<ListView
			android:id="@+id/lvToc"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:dividerHeight="4dp"
			android:choiceMode="none"
			android:divider="@android:color/transparent"
			android:scrollbars="none" />
	</LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
