<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/rootProjectView"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/toolbarLayout"
		android:layout_width="match_parent"
		android:padding="16dp"
		android:gravity="center_vertical"
		android:layout_height="?attr/actionBarSize">
		<ImageView
			android:id="@+id/btnBack"
			android:layout_width="28dp"
			android:layout_height="28dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:src="@drawable/icon_keyboard_backspace_round"
			android:scaleType="fitCenter" />
		<TextView
			android:id="@+id/tvToolbarTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="প্রজেক্ট ডিটেইলস"
			android:textSize="20sp"
			android:textStyle="bold"
			android:layout_marginStart="16dp" />
		<View
			android:id="@+id/view7"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:layout_weight="1" />
		<ImageView
			android:id="@+id/btnShare"
			android:layout_width="25dp"
			android:layout_height="25dp"
			android:layout_marginRight="10dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:scaleType="fitCenter"
			android:src="@android:drawable/ic_menu_share"
			android:layout_marginEnd="16dp" />
		<ImageView
			android:id="@+id/btnProjectOptions"
			android:layout_width="28dp"
			android:layout_height="28dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:src="@drawable/icon_more_vert_round"
			android:scaleType="fitCenter" />
	</LinearLayout>
	<androidx.core.widget.NestedScrollView
		android:id="@+id/vscroll2"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true">
		<LinearLayout
			android:id="@+id/linear8"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">
			<LinearLayout
				android:id="@+id/linear9"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="24dp"
				android:orientation="horizontal">
				<androidx.cardview.widget.CardView
					android:id="@+id/cardview2"
					android:layout_width="120dp"
					android:layout_height="170dp"
					app:cardCornerRadius="16dp"
					app:cardElevation="6dp">
					<ImageView
						android:id="@+id/imgCover"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:src="@drawable/ebook"
						android:scaleType="fitXY" />
				</androidx.cardview.widget.CardView>
				<LinearLayout
					android:id="@+id/linear10"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_marginStart="24dp">
					<TextView
						android:id="@+id/tvProjectTitle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="টাইটেল"
						android:textSize="22sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tvAuthorName"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="লেখিকা: [নাম লোড হবে]"
						android:textSize="12sp"
						android:textStyle="bold"
						android:textColor="#333333" />
					<TextView
						android:id="@+id/tvProjectCategory"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:paddingTop="4dp"
						android:paddingBottom="4dp"
						android:textSize="12sp"
						android:textStyle="bold"
						android:paddingStart="12dp"
						android:paddingEnd="12dp" />
					<LinearLayout
						android:id="@+id/customFieldsContainer"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:orientation="vertical" />
					<TextView
						android:id="@+id/tvProjectDesc"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="সারাংশ নেই..."
						android:textSize="14sp"
						android:maxLines="3"
						android:ellipsize="end"
						android:lineSpacingMultiplier="1.2" />
					<TextView
						android:id="@+id/btnReadMoreDesc"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:paddingTop="4dp"
						android:paddingBottom="4dp"
						android:text="আরো দেখুন"
						android:textSize="13sp"
						android:textStyle="bold"
						android:visibility="gone" />
				</LinearLayout>
			</LinearLayout>
			<HorizontalScrollView
				android:id="@+id/hscroll2"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:layout_marginBottom="16dp"
				android:scrollbars="none"
				android:clipToPadding="false"
				android:paddingStart="16dp"
				android:paddingEnd="16dp">
				<LinearLayout
					android:id="@+id/linear2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/tabChapters"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:text="পর্বসমূহ"
						android:textSize="14sp"
						android:textStyle="bold"
						android:paddingStart="24dp"
						android:paddingEnd="24dp"
						android:layout_marginEnd="8dp" />
					<TextView
						android:id="@+id/tabCharacters"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:text="চরিত্র"
						android:textSize="14sp"
						android:textStyle="bold"
						android:paddingStart="24dp"
						android:paddingEnd="24dp"
						android:layout_marginEnd="8dp" />
					<TextView
						android:id="@+id/tabIdeas"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:text="আইডিয়া"
						android:textSize="14sp"
						android:textStyle="bold"
						android:paddingStart="24dp"
						android:paddingEnd="24dp"
						android:layout_marginEnd="8dp" />
					<TextView
						android:id="@+id/tabSynopsis"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:text="সিনোপসিস"
						android:textSize="14sp"
						android:textStyle="bold"
						android:paddingStart="24dp"
						android:paddingEnd="24dp"
						android:layout_marginEnd="8dp" />
					<TextView
						android:id="@+id/tabGoal"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:text="সেট গোল"
						android:textSize="14sp"
						android:textStyle="bold"
						android:paddingStart="24dp"
						android:paddingEnd="24dp" />
				</LinearLayout>
			</HorizontalScrollView>
			<LinearLayout
				android:id="@+id/containerChapters"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="visible">
				<LinearLayout
					android:id="@+id/linear13"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="8dp"
					android:paddingBottom="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="24dp"
					android:paddingEnd="24dp">
					<TextView
						android:id="@+id/tvChapterHeader"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="সব পর্ব"
						android:textSize="18sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/tvChapterCount"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="(0)"
						android:textSize="16sp"
						android:layout_marginStart="8dp" />
					<View
						android:id="@+id/view14"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1" />
					<TextView
						android:id="@+id/tvTotalWordCount"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="0 শব্দ"
						android:textSize="14sp"
						android:textStyle="bold"
						android:layout_marginEnd="16dp" />
					<ImageView
						android:id="@+id/btnAddChapter"
						android:layout_width="32dp"
						android:layout_height="32dp"
						android:padding="4dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:scaleType="fitCenter"
						android:src="@android:drawable/ic_input_add" />
				</LinearLayout>
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/rvChapters"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingBottom="48dp"
					android:nestedScrollingEnabled="false"
					android:clipToPadding="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/containerCharacters"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone">
				<LinearLayout
					android:id="@+id/linear3"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="8dp"
					android:paddingBottom="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="24dp"
					android:paddingEnd="24dp">
					<TextView
						android:id="@+id/tvCharTabHeader"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="সব চরিত্র"
						android:textSize="18sp"
						android:textStyle="bold" />
					<View
						android:id="@+id/view4"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:layout_weight="1" />
					<ImageView
						android:id="@+id/btnAddCharacterTab"
						android:layout_width="32dp"
						android:layout_height="32dp"
						android:padding="4dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:scaleType="fitCenter"
						android:src="@android:drawable/ic_input_add" />
				</LinearLayout>
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/rvProjectCharacters"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingBottom="48dp"
					android:nestedScrollingEnabled="false"
					android:clipToPadding="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/containerIdeas"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:visibility="gone">
				<LinearLayout
					android:id="@+id/linear12"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="16dp"
					android:paddingBottom="8dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:paddingStart="24dp"
					android:paddingEnd="24dp">
					<TextView
						android:id="@+id/tvIdeaStats"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:text="মোট: ০ • এপ্লাই: ০ • বাকি: ০"
						android:textSize="13sp"
						android:textStyle="bold"
						android:layout_weight="1" />
					<ImageView
						android:id="@+id/btnIdeaSearch"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:padding="6dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:scaleType="fitCenter"
						android:src="@android:drawable/ic_menu_search" />
					<ImageView
						android:id="@+id/btnIdeaFilter"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:padding="6dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:scaleType="fitCenter"
						android:src="@android:drawable/ic_menu_sort_by_size"
						android:layout_marginStart="8dp" />
					<ImageView
						android:id="@+id/btnIdeaAdd"
						android:layout_width="36dp"
						android:layout_height="36dp"
						android:padding="6dp"
						android:background="?attr/selectableItemBackgroundBorderless"
						android:scaleType="fitCenter"
						android:src="@android:drawable/ic_input_add"
						android:layout_marginStart="8dp" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/searchContainerIdea"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginBottom="16dp"
					android:padding="4dp"
					android:layout_marginStart="24dp"
					android:layout_marginEnd="24dp"
					android:visibility="gone">
					<EditText
						android:id="@+id/etIdeaSearch"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="12dp"
						android:textSize="14sp"
						android:hint="আইডিয়া খুঁজুন..."
						android:singleLine="true"
						android:background="@null" />
				</LinearLayout>
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/rvIdeas"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingBottom="48dp"
					android:nestedScrollingEnabled="false"
					android:clipToPadding="false" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/containerSynopsis"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:visibility="gone">
				<ScrollView
					android:id="@+id/vscroll3"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:fillViewport="true">
					<LinearLayout
						android:id="@+id/linear16"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="24dp"
						android:orientation="vertical">
						<LinearLayout
							android:id="@+id/layoutDedication"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginBottom="24dp"
							android:padding="16dp"
							android:orientation="vertical">
							<TextView
								android:id="@+id/tvDedicationLabel"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="8dp"
								android:text="উৎসর্গ"
								android:textSize="14sp"
								android:textStyle="bold" />
							<TextView
								android:id="@+id/tvDedicationText"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:text="উৎসর্গপত্র..."
								android:textSize="14sp"
								android:lineSpacingMultiplier="1.3" />
							<TextView
								android:id="@+id/btnReadMoreDedication"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="4dp"
								android:paddingTop="4dp"
								android:paddingBottom="4dp"
								android:text="আরো দেখুন"
								android:textSize="13sp"
								android:textStyle="bold"
								android:visibility="gone" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/layoutSynopsisEmpty"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:visibility="gone">
							<ImageView
								android:id="@+id/imgSynopsisEmptyIcon"
								android:layout_width="64dp"
								android:layout_height="64dp"
								android:layout_marginBottom="16dp"
								android:scaleType="center"
								android:src="@android:drawable/ic_menu_edit" />
							<TextView
								android:id="@+id/tvSynopsisEmptyText"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="24dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="আপনার গল্পের মূল সারাংশ এখনো লেখা হয়নি। একটি দুর্দান্ত প্লট দিয়ে শুরু করুন..."
								android:textSize="14sp"
								android:lineSpacingMultiplier="1.2" />
							<TextView
								android:id="@+id/btnAddSynopsisEmpty"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:paddingTop="12dp"
								android:paddingBottom="12dp"
								android:text="সিনোপসিস লিখুন"
								android:textSize="14sp"
								android:textStyle="bold"
								android:paddingStart="32dp"
								android:paddingEnd="32dp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/layoutSynopsisContent"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:visibility="gone">
							<LinearLayout
								android:id="@+id/linear14"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="16dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/tvSynopsisTagline"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="ট্যাগলাইন এখানে থাকবে"
									android:textSize="18sp"
									android:textStyle="bold|italic"
									android:layout_weight="1"
									android:layout_marginEnd="16dp" />
								<ImageView
									android:id="@+id/btnEditSynopsis"
									android:layout_width="40dp"
									android:layout_height="40dp"
									android:padding="8dp"
									android:background="?attr/selectableItemBackgroundBorderless"
									android:scaleType="fitCenter"
									android:src="@android:drawable/ic_menu_edit" />
							</LinearLayout>
							<TextView
								android:id="@+id/tvSynopsisBody"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:text="গল্পের মূল সারাংশ এখানে থাকবে..."
								android:textSize="15sp"
								android:lineSpacingMultiplier="1.5" />
						</LinearLayout>
					</LinearLayout>
				</ScrollView>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/containerGoal"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:visibility="gone">
				<androidx.core.widget.NestedScrollView
					android:id="@+id/vscroll9"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:fillViewport="true">
					<RelativeLayout
						android:id="@+id/relativelayout8"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:padding="24dp">
						<LinearLayout
							android:id="@+id/layoutGoalEmpty"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:gravity="center_horizontal|center_vertical"
							android:orientation="vertical"
							android:visibility="gone"
							android:layout_centerInParent="true">
							<TextView
								android:id="@+id/textview31"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="16dp"
								android:text="🎯"
								android:textSize="64sp" />
							<TextView
								android:id="@+id/tvGoalEmptyText"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginBottom="32dp"
								android:gravity="center_horizontal|center_vertical"
								android:text="বড় অর্জনের জন্য ছোট ছোট লক্ষ্য প্রয়োজন। আপনার গল্পের জন্য একটি টার্গেট সেট করুন।"
								android:textSize="14sp"
								android:lineSpacingMultiplier="1.3" />
							<TextView
								android:id="@+id/btnSetNewGoal"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:paddingTop="14dp"
								android:paddingBottom="14dp"
								android:text="লক্ষ্য নির্ধারণ করুন"
								android:textSize="15sp"
								android:textStyle="bold"
								android:paddingStart="32dp"
								android:paddingEnd="32dp" />
						</LinearLayout>
						<LinearLayout
							android:id="@+id/layoutGoalDashboard"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingBottom="48dp"
							android:orientation="vertical">
							<LinearLayout
								android:id="@+id/linear33"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layout_marginBottom="24dp"
								android:gravity="center_vertical"
								android:orientation="horizontal">
								<TextView
									android:id="@+id/tvDashboardTitle"
									android:layout_width="0dp"
									android:layout_height="wrap_content"
									android:text="রাইটিং ড্যাশবোর্ড"
									android:textSize="20sp"
									android:textStyle="bold"
									android:layout_weight="1" />
								<ImageView
									android:id="@+id/btnEditGoal"
									android:layout_width="40dp"
									android:layout_height="40dp"
									android:padding="8dp"
									android:background="?attr/selectableItemBackgroundBorderless"
									android:scaleType="fitCenter"
									android:src="@android:drawable/ic_menu_edit" />
							</LinearLayout>
							<TextView
