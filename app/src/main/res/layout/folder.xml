<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/layoutFolderRoot"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#121212">
	<LinearLayout
		android:id="@+id/folderToolbar"
		android:layout_width="match_parent"
		android:layout_height="60dp"
		android:background="#1E1E24"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:elevation="4dp"
		android:paddingHorizontal="16dp">
		<ImageView
			android:id="@+id/btnBack"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:padding="6dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:scaleType="fitCenter"
			android:src="@android:drawable/ic_menu_revert" />
		<TextView
			android:id="@+id/tvPathTitle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="ফোল্ডারসমূহ"
			android:textSize="18sp"
			android:textStyle="bold"
			android:textColor="#FFFFFF"
			android:layout_marginStart="16dp"
			android:maxLines="1"
			android:ellipsize="marquee" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/layoutEmptyState"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="vertical"
		android:visibility="gone"
		android:layout_centerInParent="true">
		<TextView
			android:id="@+id/textview29"
			android:layout_width="64dp"
			android:layout_height="64dp"
			android:layout_marginBottom="8dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="📂"
			android:textSize="48sp" />
		<TextView
			android:id="@+id/textview30"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="এই ফোল্ডারটি ফাঁকা!"
			android:textSize="16sp"
			android:textColor="#9CA8AE" />
	</LinearLayout>
	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/rvFiles"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="8dp"
		android:clipToPadding="false"
		android:layout_above="@id/bottomActionLayout"
		android:layout_below="@id/folderToolbar" />
	<LinearLayout
		android:id="@+id/bottomActionLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:padding="16dp"
		android:background="#1E1E24"
		android:orientation="horizontal"
		android:elevation="8dp"
		android:layout_alignParentBottom="true">
		<TextView
			android:id="@+id/btnNewFolder"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:padding="14dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="+ ফোল্ডার"
			android:textSize="16sp"
			android:textStyle="bold"
			android:textColor="#FFFFFF"
			android:layout_weight="1"
			android:layout_marginEnd="8dp" />
		<TextView
			android:id="@+id/btnNewFile"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:padding="14dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="+ নতুন নোট"
			android:textSize="16sp"
			android:textStyle="bold"
			android:textColor="#121212"
			android:layout_weight="1"
			android:layout_marginStart="8dp" />
	</LinearLayout>
</RelativeLayout>
